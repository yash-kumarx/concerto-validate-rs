    <!-- ===== concerto-ffi (BOTTOM-RIGHT) ===== -->
    <mxCell id="13" value="&lt;b&gt;&lt;font size=&quot;15&quot;&gt;concerto-ffi&lt;/font&gt;&lt;/b&gt;&lt;hr/&gt;extern &quot;C&quot; · #[no_mangle]&lt;br/&gt;&lt;br/&gt;concerto_model_manager_new() → *mut ...&lt;br/&gt;concerto_model_manager_free(*mut ...)&lt;br/&gt;concerto_add_model(mm, json) → *mut c_char&lt;br/&gt;concerto_validate_instance(...) → *mut c_char&lt;br/&gt;concerto_free_string(*mut c_char)&lt;br/&gt;&lt;br/&gt;Box::into_raw · Box::from_raw · CString&lt;br/&gt;no panics across FFI boundary" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
