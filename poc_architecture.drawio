    <!-- ===== concerto-core (CENTER) ===== -->
    <mxCell id="10" value="&lt;b&gt;&lt;font size=&quot;15&quot;&gt;concerto-core&lt;/font&gt;&lt;/b&gt;&lt;hr/&gt;ModelManager { models: HashMap&lt;String, ModelFile&gt; }&lt;br/&gt;&lt;br/&gt;pub fn add_model_from_json(&amp;mut self, json: &amp;str)&lt;br/&gt;pub fn validate_instance(&amp;self, inst: &amp;Value, type_name: &amp;str)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ Result&lt;ValidationResult, ConcertoError&gt;&lt;br/&gt;pub fn resolve_type(&amp;self, fqn: &amp;str) → ...&lt;br/&gt;&lt;br/&gt;declaration.rs · model_manager.rs&lt;br/&gt;instance_validator.rs · parser/ · error.rs&lt;br/&gt;&lt;br/&gt;&lt;i&gt;zero workspace dependencies&lt;/i&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="800" y="560" width="600" height="320" as="geometry" />
    </mxCell>

    <!-- ===== concerto-cli (TOP-LEFT) ===== -->
    <mxCell id="14" value="&lt;b&gt;&lt;font size=&quot;15&quot;&gt;concerto-cli&lt;/font&gt;&lt;/b&gt;&lt;hr/&gt;clap argument parsing&lt;br/&gt;&lt;br/&gt;--model &amp;nbsp;&amp;nbsp; model.json&lt;br/&gt;--instance &amp;nbsp;instance.json&lt;br/&gt;--type &amp;nbsp;&amp;nbsp;&amp;nbsp; org.hr@1.0.0.Employee&lt;br/&gt;&lt;br/&gt;prints ValidationResult as JSON to stdout&lt;br/&gt;&lt;br/&gt;exit code 0 = valid&lt;br/&gt;exit code 1 = invalid" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="80" y="200" width="430" height="310" as="geometry" />
