    <!-- ===== concerto-wasm (TOP-RIGHT) ===== -->
    <mxCell id="12" value="&lt;b&gt;&lt;font size=&quot;15&quot;&gt;concerto-wasm&lt;/font&gt;&lt;/b&gt;&lt;hr/&gt;wasm-bindgen · wasm-pack&lt;br/&gt;&lt;br/&gt;WasmModelManager { inner: ModelManager }&lt;br/&gt;&lt;br/&gt;addModelValue(value: JsValue)&lt;br/&gt;validateInstanceValue(value: JsValue, type_name: &amp;str)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ Result&lt;JsValue, JsValue&gt;&lt;br/&gt;&lt;br/&gt;JsValue ↔ serde_json::Value&lt;br/&gt;(via serde_wasm_bindgen)" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
