<?xml version="1.0" encoding="UTF-8"?>
<mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- Title -->
    <mxCell id="2" value="collect_properties_inner() — How Inheritance Walk Works" style="text;html=1;align=center;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="80" y="15" width="780" height="28" as="geometry" />
    </mxCell>

    <!-- TYPE HIERARCHY label -->
    <mxCell id="3" value="Type Hierarchy" style="text;html=1;align=left;fontSize=11;fontStyle=2;strokeColor=none;fillColor=none;fontColor=#888888;" vertex="1" parent="1">
      <mxGeometry x="30" y="55" width="160" height="18" as="geometry" />
    </mxCell>

    <!-- Entity (abstract) -->
    <mxCell id="4" value="&lt;i&gt;&lt;b&gt;Entity&lt;/b&gt;&lt;/i&gt; (abstract)&lt;hr/&gt;id : String" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#888888;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="30" y="76" width="175" height="70" as="geometry" />
    </mxCell>

    <!-- Person -->
    <mxCell id="5" value="&lt;b&gt;Person&lt;/b&gt;&lt;br/&gt;extends Entity&lt;hr/&gt;name : String&lt;br/&gt;age : Integer" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="255" y="76" width="175" height="70" as="geometry" />
    </mxCell>

    <!-- Employee -->
    <mxCell id="6" value="&lt;b&gt;Employee&lt;/b&gt;&lt;br/&gt;extends Person&lt;hr/&gt;employeeId : String&lt;br/&gt;role : Role" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="480" y="76" width="175" height="70" as="geometry" />
    </mxCell>

    <!-- extends arrows pointing left (child → parent) -->
    <mxCell id="7" value="extends" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;strokeColor=#6c8ebf;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="5" target="4" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="8" value="extends" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;strokeColor=#6c8ebf;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="6" target="5" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- RECURSIVE WALK label -->
    <mxCell id="9" value="Recursive call stack — validate_instance(Employee) triggers this" style="text;html=1;align=left;fontSize=11;fontStyle=2;strokeColor=none;fillColor=none;fontColor=#888888;" vertex="1" parent="1">
      <mxGeometry x="30" y="170" width="500" height="18" as="geometry" />
    </mxCell>

    <!-- Call 1: Employee -->
    <mxCell id="10" value="&lt;b&gt;collect(Employee)&lt;/b&gt; &amp;nbsp; visited: { Employee }&lt;br/&gt;super_type = &quot;Person&quot; → recurse ↓" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
      <mxGeometry x="30" y="193" width="570" height="48" as="geometry" />
    </mxCell>

    <!-- Call 2: Person (indented) -->
    <mxCell id="11" value="&lt;b&gt;collect(Person)&lt;/b&gt; &amp;nbsp; visited: { Employee, Person }&lt;br/&gt;super_type = &quot;Entity&quot; → recurse ↓" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
      <mxGeometry x="55" y="256" width="545" height="48" as="geometry" />
    </mxCell>

    <!-- Call 3: Entity — base case -->
    <mxCell id="12" value="&lt;b&gt;collect(Entity)&lt;/b&gt; &amp;nbsp; visited: { Employee, Person, Entity }&lt;br/&gt;super_type = None → &lt;b&gt;base case&lt;/b&gt; → return { id: String }" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
      <mxGeometry x="80" y="319" width="520" height="48" as="geometry" />
    </mxCell>

    <!-- Phase 1 label -->
    <mxCell id="25" value="Phase 1 — descend (recurse to root)" style="text;html=1;align=left;fontSize=10;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="30" y="170" width="300" height="16" as="geometry" />
    </mxCell>

    <!-- Phase 2 label -->
    <mxCell id="26" value="Phase 2 — unwind (collect props, child wins)" style="text;html=1;align=left;fontSize=10;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="30" y="376" width="310" height="16" as="geometry" />
    </mxCell>

    <!-- Return in Person: add name, age -->
    <mxCell id="14" value="&lt;b&gt;back in Person:&lt;/b&gt; insert own props (child wins on collision)&lt;br/&gt;{ id } + { name, age } → &lt;b&gt;{ id, name, age }&lt;/b&gt;" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
      <mxGeometry x="55" y="397" width="545" height="48" as="geometry" />
    </mxCell>

    <!-- Return in Employee: add employeeId, role -->
    <mxCell id="15" value="&lt;b&gt;back in Employee:&lt;/b&gt; insert own props (child wins on collision)&lt;br/&gt;{ id, name, age } + { employeeId, role } → &lt;b&gt;{ id, name, age, employeeId, role }&lt;/b&gt;" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
      <mxGeometry x="30" y="460" width="570" height="48" as="geometry" />
    </mxCell>

    <!-- Final props map -->
    <mxCell id="16" value="&lt;b&gt;Final props map handed to the validator:&lt;/b&gt;&lt;br/&gt;id: String &amp;nbsp;·&amp;nbsp; name: String &amp;nbsp;·&amp;nbsp; age: Integer &amp;nbsp;·&amp;nbsp; employeeId: String &amp;nbsp;·&amp;nbsp; role: Role" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="30" y="530" width="570" height="52" as="geometry" />
    </mxCell>

    <!-- visited HashSet box (right side) -->
    <mxCell id="17" value="&lt;b&gt;visited: HashSet&lt;String&gt;&lt;/b&gt;&lt;hr/&gt;&quot;Employee&quot;&lt;br/&gt;&quot;Person&quot;&lt;br/&gt;&quot;Entity&quot;&lt;br/&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;if same FQN seen twice&lt;br/&gt;→ Err(CircularDependency)&lt;/font&gt;" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="730" y="193" width="205" height="175" as="geometry" />
    </mxCell>

    <!-- Bottom note -->
    <mxCell id="18" value="this is why validate_instance(Employee) correctly catches a missing &quot;id&quot; field even though &quot;id&quot; is declared on Entity, not Employee" style="text;html=1;align=center;fontSize=10;fontStyle=2;strokeColor=none;fillColor=none;fontColor=#888888;" vertex="1" parent="1">
      <mxGeometry x="30" y="596" width="700" height="18" as="geometry" />
    </mxCell>

    <!-- Arrows between call boxes -->
    <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="10" target="11" parent="1">
      <mxGeometry relative="1" as="geometry" />
