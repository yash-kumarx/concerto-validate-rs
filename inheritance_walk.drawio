      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="14" target="15" parent="1">
      <mxGeometry relative="1" as="geometry" />
